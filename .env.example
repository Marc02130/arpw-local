# Copy to .env. Compose interpolates POSTGRES_* into DATABASE_URL.
# Do not set DATABASE_URL, VITE_*, or NEXT_PUBLIC_* here.
# Do not put OpenAI / xAI / Anthropic keys here — paste them on Profile (PR 04).
#
# Production behind TLS: COOKIE_SECURE=true and PUBLIC_ORIGINS=https://your.host
# Host webpack overlay: docker compose -f docker-compose.yml -f docker-compose.dev.yml up
#   (API on localhost:8001; Compose nginx SPA stays on :8080).

POSTGRES_USER=arpw
POSTGRES_PASSWORD=changeme
POSTGRES_DB=arpw

JWT_SECRET=change-me-to-a-long-random-string-32+
COOKIE_SECURE=false

# CSRF Origin allowlist (comma-separated). Docker nginx :8080 and webpack-dev-server :3000.
PUBLIC_ORIGINS=http://localhost:8080,http://localhost:3000

# Empty = CORS middleware off. Do not set *.
CORS_ORIGINS=

PUBLIC_APP_URL=http://localhost:8080

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
