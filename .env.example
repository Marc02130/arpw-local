# Copy to .env. Compose interpolates POSTGRES_* into DATABASE_URL.
# Do not set DATABASE_URL, VITE_*, or NEXT_PUBLIC_* here.
# Do not put OpenAI / xAI / Anthropic keys here — paste them on Profile (PR 04).
#
# Production behind TLS: COOKIE_SECURE=true and PUBLIC_ORIGINS=https://your.host
# Host webpack overlay: docker compose -f docker-compose.yml -f docker-compose.dev.yml up
#   (API on localhost:8002; Compose nginx SPA stays on :8082).
# RAGged uses :8080 / :8001. ARPW Mailpit UI is :54324; enable smtp_port = 54325 there.

POSTGRES_USER=arpw
POSTGRES_PASSWORD=changeme
POSTGRES_DB=arpw

JWT_SECRET=change-me-to-a-long-random-string-32+
COOKIE_SECURE=false

# CSRF Origin allowlist (comma-separated). Docker nginx :8082 and webpack-dev-server :3001.
PUBLIC_ORIGINS=http://localhost:8082,http://localhost:3001

# Empty = CORS middleware off. Do not set *.
CORS_ORIGINS=

PUBLIC_APP_URL=http://localhost:8082

# Shared with ARPW's local mailbox (UI http://127.0.0.1:54324). Not a second Mailpit.
SMTP_HOST=host.docker.internal
SMTP_PORT=54325
SMTP_FROM=noreply@localhost

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
